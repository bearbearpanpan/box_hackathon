# ---------------------------------------------------------------------------
# Reality Check — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# ---- Box API (Server auth / Client Credentials Grant) ---------------------
# Create a Box custom app (Server Authentication with Client Credentials Grant)
# in the Box Developer Console, then paste the values here.
BOX_CLIENT_ID=your_box_client_id
BOX_CLIENT_SECRET=your_box_client_secret
BOX_ENTERPRISE_ID=your_box_enterprise_id
# Folder in Box where contracts live / reports are written back.
BOX_CONTRACTS_FOLDER_ID=0
BOX_REPORTS_FOLDER_ID=0

# ---- Box AI --------------------------------------------------------------
# Box AI is accessed through the same Box API token; no separate key needed.
# Toggle whether to call Box AI for extraction/summaries (vs. local fallback).
USE_BOX_AI=true

# ---- AWS Bedrock ----------------------------------------------------------
AWS_REGION=us-east-1
# Model used by the agent for drafting / risk / research reasoning.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# If deploying the agent itself (not just invoking a model):
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# AWS credentials are taken from the standard provider chain
# (env vars / ~/.aws/credentials / instance role). For local dev you may set:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# Alternatively, use a Bedrock API key (bearer token). This is a newer, simpler
# way to authenticate to Bedrock and REPLACES the AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY pair above (you do not need both). You still must set
# AWS_REGION and BEDROCK_MODEL_ID alongside it. Requires boto3/botocore >= 1.39.
# AWS_BEARER_TOKEN_BEDROCK=
